{
  "version": 2,
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "api/frontend.js", "use": "@vercel/node" },
    { "src": "api/restore.js", "use": "@vercel/node" },
    { "src": "api/students.js", "use": "@vercel/node" },
    { "src": "api/students/[id].js", "use": "@vercel/node" },
    { "src": "api/instructors-fixed.js", "use": "@vercel/node" },
    { "src": "api/instructor-detail.js", "use": "@vercel/node" },
    { "src": "api/instructor-daily.js", "use": "@vercel/node" },
    { "src": "api/vehicle-lookup.js", "use": "@vercel/node" },
    { "src": "api/sessions/active-v3.js", "use": "@vercel/node" },
    { "src": "api/sessions/start-v3.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/restore/(.*)", "dest": "/api/restore.js" },
    { "src": "/api/students/([^/]+)", "dest": "/api/students/[id].js" },
    { "src": "/api/students", "dest": "/api/students.js" },
    { "src": "/api/instructors/([^/]+)/daily", "dest": "/api/instructor-daily.js?id=$1" },
    { "src": "/api/instructors/([^/]+)", "dest": "/api/instructor-detail.js?id=$1" },
    { "src": "/api/instructors", "dest": "/api/instructors-fixed.js" },
    { "src": "/api/vehicle-lookup", "dest": "/api/vehicle-lookup.js" },
    { "src": "/api/sessions/active-v3", "dest": "/api/sessions/active-v3.js" },
    { "src": "/api/sessions/start-v3", "dest": "/api/sessions/start-v3.js" },
    { "src": "/", "dest": "/api/frontend.js" },
    { "src": "/(.*)", "dest": "/api/index.js" }
  ]
}
