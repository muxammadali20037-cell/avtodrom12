{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "api/restore.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/restore/(.*)",
      "dest": "/api/restore.js"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.js"
    }
  ]
}
